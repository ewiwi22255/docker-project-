# 部署設定：複製成 .env.docker 再修改（cp .env.docker.example .env.docker）。
# .env.docker 可能含金鑰，已列在 .gitignore，不會上傳到 GitHub。

# ── 對外埠號 ──
# 瀏覽器連 http://<電腦IP>:這個埠。80 被占用就改 8080。
ERP_HTTP_PORT=80

# ── 映像版本（選用）──
# 預設用 latest；要固定版本可改成 GitHub Packages 頁面上列出的標籤（例如 :sha-xxxxxxx）
# ERP_BACKEND_IMAGE=ghcr.io/ewiwi22255/docker-project-test-backend:latest
# ERP_WEB_IMAGE=ghcr.io/ewiwi22255/docker-project-test-web:latest

# ── 示範模式 ──
# true：自動建立示範帳號（admin/admin、viewer/viewer、planner/planner、approver/approver…）與示範資料。
# 只適合內網測試或展示；放到公開網路前務必改成 false 並建立正式帳號。
ERP_DEMO_MODE=true
ERP_ENABLE_DEMO_SEED=false

# ── 登入權杖 ──
# 簽章金鑰：留空會自動產生並存在資料庫 volume 裡（重啟後仍有效）。
# ERP_API_SECRET=
# 登入有效秒數，預設 28800（8 小時）
# ERP_API_TOKEN_TTL=28800

# ── AI 模型（客戶 AI 分析）──
# 不填則 AI 按鈕會顯示「暫時無法產生」。
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── 背景排程與 LINE：預設關閉 ──
ERP_SCHEDULER_ENABLED=0
LINE_BRIEFING_ENABLED=false
